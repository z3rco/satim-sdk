{
    "compilerOptions": {
        "lib": [
            "ESNext",
            "DOM"
        ],
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests"
    ]
}