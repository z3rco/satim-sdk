{
  "name": "satim-module",
  "version": "1.0.0",
  "description": "Stateless, secure, zero-dependency TypeScript SDK for the SATIM payment gateway — CIB & Edahabia card payments for Algeria",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "typedoc",
    "docs:serve": "typedoc && bunx serve docs/api"
  },
  "keywords": [
    "satim",
    "payment",
    "payment-gateway",
    "algeria",
    "cib",
    "edahabia",
    "sdk",
    "typescript",
    "fintech",
    "webhook",
    "zero-dependencies",
    "stateless"
  ],
  "author": "z3rco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z3rco/satim-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/z3rco/satim-sdk/issues"
  },
  "homepage": "https://z3rco.github.io/satim-sdk/",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
